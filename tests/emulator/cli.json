{
  "_comment": "The ONLY place that knows the exact pebble CLI syntax. If a command fails in Phase 0, adjust it here (run `node emulator/run.js --probe` to print the real --help texts). Placeholders: {platform} {uuid} {key} {value} {hex} {file}.",
  "pebble": "pebble",
  "commands": {
    "kill": ["kill"],
    "wipe": ["wipe"],
    "build": ["build"],
    "install": ["install", "--emulator", "{platform}"],
    "setTime": ["emu-set-time", "{time}", "--emulator", "{platform}"],
    "timeFormat": ["emu-time-format", "--format", "{format}", "--emulator", "{platform}"],
    "battery": ["emu-battery", "--percent", "{percent}", "--emulator", "{platform}"],
    "batteryCharging": ["emu-battery", "--percent", "{percent}", "--charging", "--emulator", "{platform}"],
    "bluetooth": ["emu-bt-connection", "--connected", "{connected}", "--emulator", "{platform}"],
    "screenshot": ["screenshot", "{file}", "--no-correction", "--no-open", "--emulator", "{platform}"]
  },
  "sendAppMessage": {
    "base": ["send-app-message", "--emulator", "{platform}", "--app-uuid", "{uuid}"],
    "int": ["--int", "{key}", "{value}"],
    "string": ["--string", "{key}", "{value}"],
    "bytes": ["--bytes", "{key}", "{hex}"]
  },
  "probe": [["install", "--help"], ["send-app-message", "--help"], ["screenshot", "--help"], ["emu-set-time", "--help"], ["emu-battery", "--help"]],
  "timing": { "afterInstallMs": 12000, "betweenMessagesMs": 300, "afterTimeMs": 500 },
  "platformsDefault": ["flint", "emery", "gabbro"]
}
